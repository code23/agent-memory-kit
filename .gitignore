# Runtime state and outputs: never commit (use a private MEMORY_ROOT outside the clone)
funnel/archive/
funnel/router/
funnel/ledger/
funnel/staging/
funnel/.notify-pending/
funnel/*.log
*.capture-state.json
*.jsonl
router/.dirty
/vault/_outputs/*
!/vault/_outputs/.gitkeep

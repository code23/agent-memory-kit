":"""
import sys
sys.dont_write_bytecode = True
from pathlib import Path

if sys.version_info < (3, 11):
    raise SystemExit("Python 3.11 or newer is required; install prerequisites separately.")
# -I excludes the script directory; only this operator-protected copy is trusted.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from memory_kit.__main__ import main

if __name__ == "__main__":
    raise SystemExit(main())
